// ~/.claude/settings.json, annotated reference
//
// This is a REFERENCE, not a drop-in config. Comments are not valid JSON;
// strip them (or run through any JSONC-to-JSON tool) before this becomes
// a real settings.json. Every path, domain, and command below is an
// example, replace with your own before trusting any of it.
//
// Verified against Claude Code's own docs (Configure permissions,
// Sandboxing, Settings reference) as of the date this file was written,
// not guessed. Where a doc caveat matters, it is quoted or paraphrased
// inline rather than silently omitted.
//
// Scope: everything below is valid in ~/.claude/settings.json (your
// personal, all-projects settings). A short list of related keys that
// only work from an admin-level managed-settings.json is called out at
// the bottom for awareness, they are not usable in this file.
{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",

  // -----------------------------------------------------------------
  // PERMISSIONS
  // Rules are evaluated deny, then ask, then allow. First match wins,
  // regardless of which rule is more specific: a broad deny always
  // beats a narrow allow. A bare tool name with no parens (e.g. just
  // "Bash") removes the tool from Claude's context entirely; a scoped
  // rule (with parens) leaves the tool available and blocks or prompts
  // only on matching calls.
  // -----------------------------------------------------------------
  "permissions": {
    "defaultMode": "default", // asks each time; also: acceptEdits | plan | auto | dontAsk | bypassPermissions

    "deny": [
      // --- Filesystem: Read/Edit rules use gitignore-style globs.
      // A single "*" matches one path segment only; "**" is required
      // to reach nested files and subdirectories. A Read deny also
      // blocks Edit/Write on the same path (but not NotebookEdit,
      // add a matching Edit(...) rule if notebooks matter to you).
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.netrc)",
      "Read(~/doc/**)",              // example: your own sensitive docs dir
      "Read(~/sec/**)",              // example: your own secrets dir
      "Read(**/*.pem)",              // any private-key-shaped file, any depth
      "Read(**/.env)",               // any .env file, any depth
      "Read(**/.env.*)",             // .env.local, .env.production, etc.
      "Read(//dev/**)",              // raw block/char devices, filesystem-wide
      "Edit(//dev/**)",              // blocks writes AND output-redirect targets,
                                      // since redirect targets are checked against
                                      // Edit rules, not against Bash command text

      // --- /cd: block moving the session into sensitive directories.
      // Cd path patterns share the //, ~/, / anchors above; "*" matches
      // one segment, "**" crosses segments, and a trailing /** also
      // matches the named root itself. Cd is not model-invocable, these
      // rules only apply when a human runs /cd themselves.
      //
      // Observed in practice: on a real v2.1.252 install (well past the
      // "/cd requires v2.1.169+" line in the docs), these three lines
      // produced a startup warning, "Permission deny rule ... matches no
      // known tool, check for typos", even though Cd rules are current,
      // documented syntax and not a typo. The changelog has no "added Cd
      // permission rules" entry through v2.1.259 either. Best guess, not
      // confirmed: Cd rule recognition may be gated behind a server-side
      // feature flag, and `claude doctor` on this same install separately
      // reported "Feature-flag evaluation disabled (disabled by
      // DO_NOT_TRACK)", so an environment with DO_NOT_TRACK set may never
      // see it turn on. Harmless either way, and worth leaving in: the
      // warning is cosmetic, and Read(...) deny rules plus
      // sandbox.filesystem.denyRead below already cover these same three
      // paths, so reads/edits stay blocked regardless of whether /cd
      // itself is currently being stopped from landing there.
      "Cd(~/.ssh/**)",
      "Cd(~/doc/**)",
      "Cd(~/sec/**)",

      // --- Bash: caution, argument-level Bash deny rules are fragile.
      // The docs warn about this directly: a rule like
      // Bash(curl http://github.com/ *) is bypassed by different flag
      // order, protocol, redirects, or shell variables. These entries
      // are friction against lazy/common invocations, not a security
      // boundary. The sandbox block below is the actual boundary.
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .)",
      "Bash(git push --force*)",
      "Bash(chmod -R 777*)",
      // Docs' own recommendation for reliable network restriction:
      // deny the raw tools outright and use WebFetch(domain:...) for
      // anything you actually want to allow.
      "Bash(curl *)",
      "Bash(wget *)"

      // --- MCP / Agent examples, uncomment and name your own:
      // "mcp__some_untrusted_server",
      // "Agent(some-untrusted-custom-agent)",
      // "WebFetch(domain:pastebin.com)",
    ],

    "ask": [
      // Not dangerous enough to hard-deny, but you want a heads-up
      // every single time, even with the tool broadly allowed below.
      "Bash(git push *)",
      "Bash(npm publish*)",
      "Bash(docker push*)"
    ],

    "allow": [
      // Routine, low-risk commands, worth not re-approving constantly.
      // Deny rules above still win on overlap, e.g. Bash(curl *) here
      // would still be blocked by the Bash(curl *) deny rule above.
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run *)",
      "Bash(npm test*)"
    ],

    // Extra directories treated like the working directory for file
    // access. Grants read/edit access only, does not load that
    // directory's own .claude/ config.
    "additionalDirectories": [],

    // Locks you out of the two modes that skip prompts entirely.
    // Works from any settings scope, including this personal one, a
    // user can set this on themselves even without an org managing it.
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },

  // -----------------------------------------------------------------
  // SANDBOX
  // OS-level enforcement (bubblewrap on Linux, seatbelt on macOS) that
  // applies to the Bash tool and everything it spawns, including a
  // script that opens a file directly, which the Read/Edit deny rules
  // above do NOT catch (those only cover Claude's own file tools and
  // the handful of file-reading Bash commands it recognizes by name,
  // e.g. cat, head, tail, sed). filesystem.denyRead below is merged
  // with the Read(...) deny rules above at the sandbox boundary, so
  // enabling this is what turns the paths above into a real
  // cross-process boundary instead of a Claude-only one.
  // -----------------------------------------------------------------
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,        // true = refuse to start if unsupported here
    "autoAllowBashIfSandboxed": true,  // sandboxed commands skip the bare-Bash prompt
    "allowUnsandboxedCommands": true,  // whether dangerouslyDisableSandbox is honored at all

    "network": {
      "allowedDomains": [
        "github.com",
        "registry.npmjs.org",
        "pypi.org"
      ],
      "deniedDomains": [],       // always blocked, even if matched above
      "strictAllowlist": true,   // deny non-listed hosts outright instead of prompting
      "allowLocalBinding": false
    },

    "filesystem": {
      // Merged with the Read(...)/Edit(...) deny rules in permissions above,
      // but NOT the same matching system, don't copy the "**" habit here.
      // permissions.deny's Read(...)/Edit(...) rules use gitignore-style
      // globs, where a bare directory needs a trailing /** to reach nested
      // files. sandbox.filesystem paths use OS-level prefix/subtree
      // matching instead: a bare directory already denies everything under
      // it. The docs' own canonical example proves this directly,
      // "denyRead": ["~/"] blocks the ENTIRE home directory with no
      // wildcard at all. So "~/.ssh" below already covers id_rsa, config,
      // known_hosts, everything nested, adding "~/.ssh/**" would just be a
      // literal, nonexistent path segment named "**", not glob recursion.
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/doc",
        "~/sec"
      ],
      "denyWrite": [
        "~/.ssh",
        "~/.bashrc",
        "~/.zshrc",
        "~/.gitconfig"
      ]
      // "disabled": true  // Linux/macOS only: drops filesystem isolation
                            // while keeping network/seccomp isolation.
                            // Leave unset for full containment.
    },

    "credentials": {
      // Keeps Bash-spawned processes from ever seeing real secret
      // values, even ones that are technically readable. "mask" swaps
      // in a sentinel inside the sandbox; only the network proxy
      // re-injects the real value, scoped to injectHosts.
      //
      // If a schema-based linter (e.g. check-jsonschema against
      // schemastore.org/claude-code-settings.json) flags "mask" here as
      // invalid, that's the public schema lagging, not a mistake in this
      // file. As of this writing, schemastore's published copy still
      // documents credentials mode as deny-only ("v2.1.187+"), while the
      // schema shipped inside current Claude Code already defines
      // enum: ["deny", "mask"] with a full feature set around it (extract,
      // decode, maskClaims, injectHosts, awsPairs, sigv4). Trust Claude
      // Code's own loader (or `claude doctor`) over a stale external
      // schema for a feature this new.
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "mask" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "mask" },
        { "name": "GITHUB_TOKEN", "mode": "mask" }
      ],
      "files": [
        { "path": "~/.netrc", "mode": "mask" },
        { "path": "~/.ssh/id_rsa", "mode": "deny" }
      ]
    }
  },

  // -----------------------------------------------------------------
  // HOOKS
  // Defense in depth beyond static permission rules: a PreToolUse hook
  // can inspect and block a call the rules above didn't anticipate.
  // This example is a pure audit trail, it does not block anything by
  // itself, extend it with a blocking exit code if you want enforcement.
  // -----------------------------------------------------------------
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command' >> ~/.claude/bash-audit-log.txt"
          }
        ]
      }
    ]
  },

  // -----------------------------------------------------------------
  // MCP
  // -----------------------------------------------------------------
  "enableAllProjectMcpServers": false, // require explicit per-project approval
  "disableClaudeAiConnectors": false   // set true to stop claude.ai connectors auto-connecting

  // -----------------------------------------------------------------
  // NOT USABLE IN THIS FILE, for awareness only.
  // These keys are real but only take effect from an admin-controlled
  // managed-settings.json (or MDM/policy source equivalent), not from
  // a normal user settings.json like this one. Even as the sole owner
  // of your own machine, you could deploy a local managed-settings.json
  // to bind yourself to these (it outranks every other settings file,
  // including this one), but that is a separate file, not this one:
  //
  //   permissions.allowManagedPermissionRulesOnly
  //   disableSideloadFlags
  //   sandbox.network.allowManagedDomainsOnly
  //   sandbox.filesystem.allowManagedReadPathsOnly
  //   allowManagedMcpServersOnly
  // -----------------------------------------------------------------
}
