{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash",
                        "args": [
                            "${CLAUDE_PLUGIN_ROOT}/hooks/sync-auto-memory-dir.sh"
                        ],
                        "timeout": 10,
                        "statusMessage": "Synchronising autoMemoryDirectory"
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "if": "Edit(**/.claude/memory/**)",
                        "command": "sh",
                        "args": [
                            "${CLAUDE_PLUGIN_ROOT}/hooks/prohibit-wikilinks.sh"
                        ],
                        "timeout": 10,
                        "statusMessage": "Checking memory for wikilinks"
                    }
                ]
            }
        ]
    }
}
