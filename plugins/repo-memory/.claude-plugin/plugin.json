{
    "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
    "name": "repo-memory",
    "version": "0.0.1",
    "displayName": "Repo Memory",
    "description": "Keeps auto memory inside the repository. At session start, points autoMemoryDirectory in the git ignored .claude/settings.local.json at the project's .claude/memory, when that directory exists.",
    "author": {
        "name": "chewygumxx",
        "email": "cgumxx@pm.me",
        "url": "https://github.com/chewygumxx"
    },
    "homepage": "https://github.com/chewygumxx/claude-library/tree/main/plugins/repo-memory",
    "license": "GPL-3.0-only",
    "keywords": ["hooks", "memory", "auto-memory"],
    "defaultEnabled": true,
    "hooks": "./hooks/hooks.json"
}
