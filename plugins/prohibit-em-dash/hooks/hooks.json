{
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "printf",
                        "args": [
                            "%s\\n",
                            "Em dashes (U+2014) are prohibited in this project: a Write or Edit whose new text contains one is blocked and must be redone in full. Use a comma, colon, semicolon or parentheses instead."
                        ],
                        "timeout": 5
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash",
                        "args": [
                            "${CLAUDE_PLUGIN_ROOT}/hooks/prohibit-em-dash.sh"
                        ],
                        "statusMessage": "Checking for em dashes",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
