{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bash",
                        "args": [
                            "${CLAUDE_PLUGIN_DIR}/hooks/prohibit-em-dash.sh"
                        ],
                        "statusMessage": "Checking for em dashes",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
}
