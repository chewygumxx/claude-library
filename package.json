{
    "name": "claude-library",
    "description": "My personal Claude Code plugins",
    "private": true,
    "keywords": [
        "claude-code",
        "claude-plugin",
        "claude",
        "llm",
        "agents"
    ],
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/claude-library",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chewygumxx/claude-library.git"
    },
    "engines": {
        "bun": ">=1.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "@chewygumxx/biome-config": "^1.1.0",
        "@chewygumxx/commitlint-config": "^1.1.0",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/markdownlint-cli2-config": "^1.1.0",
        "@chewygumxx/remark-preset": "^1.1.0",
        "@chewygumxx/yamllint-config": "^1.0.1",
        "@commitlint/cli": "^21.2.3",
        "@types/bun": "^1.4.2",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.9",
        "remark-cli": "^12.0.1",
        "shellcheck": "^4.1.0",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "bump": "bun scripts/bump-plugin.mts",
        "check": "bun run typecheck && bun run test && bun run lint:biome && bun run lint:md && bun run lint:yaml && bun run lint:toml && bun run lint:sh && bun run lint:plugins && bun run lint:emdash",
        "commit": "cz",
        "format": "biome format --write . && bun run format:yaml && bun run format:toml && bun run format:sh",
        "format:check": "biome format .",
        "format:sh": "git ls-files -z | xargs -0 -r shfmt -f | tr '\\n' '\\0' | xargs -0 -r shfmt -w",
        "format:toml": "git ls-files -z '*.toml' | xargs -0 -r tombi format",
        "format:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --write --log-level warn",
        "lint": "biome lint .",
        "lint:biome": "biome ci .",
        "lint:emdash": "git grep -nIP --untracked '\\x{2014}'; test $? -eq 1",
        "lint:md": "git ls-files -z '*.md' | xargs -0 remark --frail --quiet --no-stdout",
        "lint:plugins": "mise run --quiet lint:plugins",
        "lint:sh": "git ls-files -z | xargs -0 -r shfmt -f | tr '\\n' '\\0' | xargs -0 -r shfmt -d && git ls-files -z | xargs -0 -r shfmt -f | tr '\\n' '\\0' | xargs -0 -r shellcheck",
        "lint:toml": "git ls-files -z '*.toml' | xargs -0 -r tombi format --check && git ls-files -z '*.toml' | xargs -0 -r tombi lint --error-on-warnings",
        "lint:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --check && git ls-files -z '*.yaml' '*.yml' | xargs -0 -r yamllint --strict",
        "prepare": "test -d node_modules/husky && husky || true",
        "test": "mise run --quiet test",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    }
}
