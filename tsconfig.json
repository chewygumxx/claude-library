{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": true,
        "types": ["bun"],
        "skipLibCheck": true
    },
    "include": [
        ".commitlintrc.mts",
        ".claude/skills/*/scripts/*.mts",
        "scripts/*.mts",
        "test/*.mts"
    ]
}
