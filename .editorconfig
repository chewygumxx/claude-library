# vim:set expandtab shiftwidth=4 filetype=editorconfig:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/claude-library.git
# ::: :/.editorconfig
#
#

root = true

# ----------
# All files
# ----------
[*]

charset = utf-8

indent_size = 4
indent_style = space
trim_trailing_whitespace = true

end_of_line = lf
insert_final_newline = true

# ---------
# Markdown
# ---------
[*.md]
indent_size = 2

# ------
# Shell
# ------
# shfmt's own section, matching shell scripts by shebang as well as by
# extension, so git hooks without one are included. Its defaults, stated so
# they are not left to whichever shfmt runs.
[[shell]]
binary_next_line = false
function_next_line = false
keep_padding = false
space_redirects = false
switch_case_indent = false
