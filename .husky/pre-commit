#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/claude-library.git
# ::: :/.husky/pre-commit
#
#

set -e

bunx --bun --no-install tsc
bunx --bun --no-install biome check --staged --no-errors-on-unmatched

git diff -z --cached --name-only --diff-filter=ACMR -- '*.md' |
    xargs -0 -r bunx --bun --no-install remark --frail --quiet --no-stdout

git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
    xargs -0 -r bunx --bun --no-install prettier --check
git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
    xargs -0 -r yamllint --strict

git diff -z --cached --name-only --diff-filter=ACMR -- '*.toml' |
    xargs -0 -r tombi format --check
git diff -z --cached --name-only --diff-filter=ACMR -- '*.toml' |
    xargs -0 -r tombi lint --error-on-warnings

# U+2014 as UTF-8 bytes, so this file does not trip its own check. Colour and
# external diff drivers are disabled: either would hide the leading "+".
emdash=$(printf '\342\200\224')
if git diff --cached --no-color --no-ext-diff -U0 | grep '^+' | grep -q "$emdash"; then
    echo "Em dash (U+2014) in staged changes; em dashes are prohibited." >&2
    exit 1
fi
