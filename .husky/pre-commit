#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/claude-library.git
# ::: :/.husky/pre-commit
#
#

set -e

bunx --bun --no-install tsc
bunx --bun --no-install biome check --staged --no-errors-on-unmatched

git diff -z --cached --name-only --diff-filter=ACMR -- '*.md' |
    xargs -0 -r bunx --bun --no-install remark --frail --quiet --no-stdout

git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
    xargs -0 -r bunx --bun --no-install prettier --check
git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
    xargs -0 -r yamllint --strict

git diff -z --cached --name-only --diff-filter=ACMR -- '*.toml' |
    xargs -0 -r tombi format --check
git diff -z --cached --name-only --diff-filter=ACMR -- '*.toml' |
    xargs -0 -r tombi lint --error-on-warnings

# Shell scripts are found by shebang as well as extension, as git hooks have
# none. shfmt -f prints one per line, so newlines are turned back into NULs.
git diff -z --cached --name-only --diff-filter=ACMR | xargs -0 -r shfmt -f |
    tr '\n' '\0' | xargs -0 -r shfmt -d
git diff -z --cached --name-only --diff-filter=ACMR | xargs -0 -r shfmt -f |
    tr '\n' '\0' | xargs -0 -r shellcheck

if ! git diff --cached --quiet -- .claude-plugin plugins; then
    mise run --quiet lint:plugins
fi

# U+2014 as UTF-8 bytes, so this file does not trip its own check. Colour,
# external diff drivers and textconv filters are disabled: each can hide the
# leading "+" or rewrite the em dash, such as a JSON textconv to "\u2014".
emdash=$(printf '\342\200\224')
if git diff --cached --no-color --no-ext-diff --no-textconv -U0 | grep '^+' | grep -q "$emdash"; then
    echo "Em dash (U+2014) in staged changes; em dashes are prohibited." >&2
    exit 1
fi
